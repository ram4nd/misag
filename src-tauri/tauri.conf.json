{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mischief of Agents",
  "version": "0.1.0",
  "identifier": "io.github.ram4nd.misag",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mischief of Agents",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Ra Mänd",
    "copyright": "Copyright (C) 2026 Ra Mänd",
    "license": "GPL-3.0-only",
    "category": "DeveloperTool",
    "shortDescription": "A terminal for keeping AI agents on the path you set",
    "longDescription": "Run Claude Code agents in tabs that remember their sessions, turn their auto memory off, and give them flows: graphs of steps they work through on their own.",
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/mischief-of-agents/copyright": "../LICENSE"
        }
      }
    },
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
