# Maintainer: Ra Mänd
# Repackages the Linux .deb from the GitHub release; build.sh builds it from a local
# `pnpm tauri build --bundles deb` instead.
pkgname=misag-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Mischief of Agents: a Linux terminal for keeping AI agents on the path you set"
arch=('x86_64')
url="https://github.com/ram4nd/mischief-of-agents"
license=('GPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3')
optdepends=('claude-code: Claude tabs and flows')
provides=('misag')
conflicts=('misag')
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/Mischief-of-Agents_${pkgver}_Linux_x64.deb")
sha256sums=('a8107bb4e8e203d58981a30b40ce5d20074d58407e8046c6a7a42973d3b44c6d')

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"

  # Tauri names the desktop file after the product and puts the 256px icon in a "256x256@2" folder.
  cd "$pkgdir/usr/share"
  mv "applications/Mischief of Agents.desktop" applications/misag.desktop
  mkdir -p icons/hicolor/256x256/apps
  mv icons/hicolor/256x256@2/apps/misag.png icons/hicolor/256x256/apps/misag.png
  rm -r icons/hicolor/256x256@2

  # The .deb carries the license where Debian keeps it; Arch keeps it under licenses/.
  mkdir -p "licenses/$pkgname"
  mv doc/mischief-of-agents/copyright "licenses/$pkgname/LICENSE"
  rm -r doc
}
